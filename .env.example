# =====================================================================
# Woodlands Tai Chi — environment variables
# Copy this file to .env.local and fill in values for local development.
# =====================================================================

# --- Supabase (local) ---------------------------------------------------
# After running `supabase start`, the CLI prints these values.
# Defaults below match the standard local Supabase setup.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...REPLACE_WITH_LOCAL_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJ...REPLACE_WITH_LOCAL_SERVICE_ROLE_KEY

# --- App secrets --------------------------------------------------------
# 32+ random bytes used to HMAC-sign QR-code tokens. Generate with:
#   openssl rand -base64 48
QR_TOKEN_SECRET=REPLACE_WITH_RANDOM_SECRET

# --- Email (Resend) — Phase 3 ------------------------------------------
# Local dev sends mail to Inbucket (http://127.0.0.1:54324).
# Only set RESEND_API_KEY in production.
# RESEND_API_KEY=
EMAIL_FROM="Woodlands Tai Chi <noreply@woodlandstaichi.com>"

# --- Cloudflare Turnstile (CAPTCHA) — Phase 1.5 -------------------------
# Free, privacy-friendly CAPTCHA on public forms.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Public site URL (used in canonical links / emails) -----------------
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

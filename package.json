{
  "name": "woodlandstaichi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:next": "next dev",
    "dev:db": "set -a; [ -f .env.local ] && . ./.env.local; set +a; supabase start && supabase status",
    "dev:all": "concurrently --kill-others-on-fail --names \"DB,NEXT\" --prefix-colors \"green,cyan\" \"npm:dev:db\" \"npm:dev:next\"",
    "db:start": "set -a; [ -f .env.local ] && . ./.env.local; set +a; supabase start",
    "db:stop": "supabase stop",
    "db:reset": "set -a; [ -f .env.local ] && . ./.env.local; set +a; supabase db reset",
    "db:restore": "bash scripts/db-restore.sh",
    "db:reset:full": "npm run db:reset && npm run db:restore",
    "db:status": "supabase status",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.0",
    "@zxing/browser": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

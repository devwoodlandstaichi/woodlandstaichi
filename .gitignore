# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit. Use .env.example as the template.
.env
.env.*
!.env.example

# vercel / cloudflare
.vercel
.wrangler

# supabase local — generated by `supabase start`
supabase/.branches
supabase/.temp
supabase/logs

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / OS
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# logs
*.log

# secrets / keys (defensive — anything with these patterns)
*.key
*.pem
service-account*.json
